# 本机开发环境配置（bun run dev / bun run dev:server）
# 复制为项目根目录的 .env 后，按需修改。
# 本文件只用于本机开发的监听与数据目录参数；业务设置、时区和管理密码均通过后台管理。
# 首次启动会自动生成管理员密码并输出到启动日志。Docker Compose 部署不需要此文件。

# 本机开发服务配置
PORT=17321
HOST=0.0.0.0
STORAGE_DRIVER=sqlite
DATA_DIR=./data

# 临时演示模式：所有业务数据只保存在进程内存中，服务重启后清空，不创建持久化数据库文件。
# STORAGE_DRIVER=memory

# 可选：独立部署在其他主机或域名上的前端可配置可信 Origin，多个来源用逗号分隔。
# 本机当前网卡 IP 的同服务端口来源，以及 Vite 默认端口 5173，会自动识别，无需逐个填写。
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://ops.example.com

# 纯静态前端部署（前端在 Cloudflare Pages / Vercel 等平台，后端在另一台主机）：
# 设为 open 后允许任意前端来源访问，管理接口改用 Bearer 令牌鉴权（不再使用 Cookie）。
# CORS_MODE=open

# 反向代理跳数：0 表示不信任任何转发头；Cloudflare Tunnel 直连通常为 1。
# TRUST_PROXY_HOPS=1

# 反向代理所在网段（逗号分隔）。配置后，只有来自这些网段的请求才会读取转发头，
# 其他来源的 X-Forwarded-For / CF-Connecting-IP 一律忽略，防止伪造真实 IP。
# docker 默认 bridge 通常是 172.17.0.0/16；用 docker network inspect 确认。
# TRUSTED_PROXY_CIDRS=172.17.0.0/16

# 通过 Cloudflare / cloudflared 暴露时设为 1，优先使用 CF-Connecting-IP 作为真实客户端 IP。
# 必须同时设置 TRUSTED_PROXY_CIDRS，否则启动会报错。
# TRUST_CLOUDFLARE_IP=0

# 首次启动时的初始管理员密码（至少 8 位）。数据库已有管理员凭据时该变量被忽略，
# 不会重置密码。适用于 Docker / 单机后端部署；纯前端部署无需设置。
# DEFAULT_ADMIN_PASSWORD=
