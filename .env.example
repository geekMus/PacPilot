# 复制为 .env 后按需修改（Bun 会自动加载项目根目录的 .env）
#   cp .env.example .env
#
# 数据目录说明见 README「数据目录」：
# - 开发：默认项目下 ./data
# - 生产：按操作系统落到标准目录
# - Docker：默认 /data
# 若设置 DATA_DIR，则始终使用你指定的路径（最高优先级）

# DATA_DIR=./data

PORT=17321
HOST=0.0.0.0

# 设置后启用后台 /admin
ADMIN_PASSWORD=dev-password-change-me

# SESSION_SECRET=please-use-a-long-random-string
TZ=Asia/Shanghai

# 可选：强制环境（一般不必手写；dev/start 脚本会设置）
# GENPAC_ENV=development
# NODE_ENV=development
