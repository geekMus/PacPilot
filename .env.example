# Docker Compose 部署配置
# 复制为 .env 后，至少设置 ADMIN_PASSWORD：
#   Linux / macOS / Git Bash: cp .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env

# 浏览器访问使用的宿主机端口；如 17321 被占用，可改为 17322
HOST_PORT=17321

# 后台管理密码（必填，请改为自己专用的强密码）
ADMIN_PASSWORD=

# 日志及页面时间显示时区
TZ=Asia/Shanghai

# 可选：为后台会话设置独立的随机签名密钥
# SESSION_SECRET=replace-with-a-long-random-string

# 直接使用 Bun 在宿主机运行时，可按需设置以下变量：
# PORT=17321
# HOST=0.0.0.0
# DATA_DIR=./data
