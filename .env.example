# 本机开发环境配置（bun run dev / bun run dev:server）
# 复制为项目根目录的 .env 后，按需修改。
# 开发环境中，.env 的值优先于 shell 中同名的环境变量。
# Docker / 生产部署不需要此文件，请直接注入环境变量。

# 后台管理密码；留空时后台管理功能不会启用
ADMIN_PASSWORD=

# 可选：为后台会话设置独立的随机签名密钥
# SESSION_SECRET=replace-with-a-long-random-string

# 本机开发服务配置
PORT=17321
HOST=0.0.0.0
DATA_DIR=./data

# 日志及页面时间显示时区
TZ=Asia/Shanghai
