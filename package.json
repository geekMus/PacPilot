{
  "name": "PacPilot",
  "version": "2026.10.28",
  "private": false,
  "description": "带 Web 管理后台的 PAC 生成与管理服务，支持自定义规则、远程域名列表、工作流、定时更新和 Webhook 通知",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run scripts/dev-server.ts",
    "dev:client": "bun run vite --config client/vite.config.ts",
    "build": "bun run build:client",
    "build:client": "bun run vite build --config client/vite.config.ts",
    "start": "bun run scripts/start-prod.ts",
    "preview": "bun run build && bun run scripts/preview.ts",
    "typecheck": "bun run tsc --project tsconfig.json --noEmit && bun run tsc --project server/tsconfig.json --noEmit && bun run vue-tsc --project client/tsconfig.json --noEmit",
    "check": "bun run typecheck && bun run build && bun run check:i18n && bun run check:icons",
    "check:icons": "bun run scripts/check-app-icons.ts",
    "check:i18n": "bun run scripts/check-i18n.ts",
    "reset:admin-password": "bun run scripts/reset-admin-password.ts",
    "reset:admin-password:development": "bun run scripts/reset-admin-password.ts --development",
    "reset:admin-password:production": "bun run scripts/reset-admin-password.ts --production",
    "format": "prettier --write \"**/*.{ts,vue,js,cjs,mjs,json,css,md,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,js,cjs,mjs,json,css,md,html,yml,yaml}\"",
    "test": "bun run test:core && bun run test:server:coverage && bun run test:client:coverage",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:server:coverage": "vitest run --config server/vitest.config.ts --coverage",
    "test:client": "vitest run --config client/vitest.config.ts",
    "test:client:coverage": "vitest run --config client/vitest.config.ts --coverage",
    "test:coverage": "bun run test:server:coverage && bun run test:client:coverage",
    "prepare": "husky",
    "test:core": "bun test ./server/tests/core-validation.test.ts ./server/tests/storage-sqlite.bun.ts ./server/tests/storage-sqlite-migrations.bun.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.2",
    "@lucide/vue": "^1.59.0",
    "codemirror": "^6.0.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "cronstrue": "^3.32.0",
    "dotenv": "^18.0.8",
    "echarts": "^6.1.0",
    "express": "^5.3.0",
    "javascript-obfuscator": "^5.9.0",
    "node-cron": "^4.6.0",
    "reka-ui": "^2.6.0",
    "terser": "^5.44.0",
    "vue-i18n": "11",
    "vue-json-pretty": "^2.6.0",
    "vue-sonner": "^1.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "chrome-launcher": "^1.2.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "7.3.6",
    "vitest": "^5.0.5",
    "vue": "^3.5.13",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  },
  "license": "AGPL-3.0-only"
}
