{
  "name": "genpac-runner",
  "version": "2026.10.19-r18",
  "private": true,
  "description": "自动生成 PAC 文件工具，支持自定义规则 / GFWList、Vue3 后台与 Webhook（Bun 运行时）",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run scripts/dev-server.ts",
    "dev:client": "bunx --bun vite --config client/vite.config.ts",
    "build": "bun run build:client",
    "build:client": "bunx --bun vite build --config client/vite.config.ts",
    "start": "bun run scripts/start-prod.ts",
    "typecheck": "bunx tsc -p server/tsconfig.json --noEmit && bunx vue-tsc -p client/tsconfig.json --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.2",
    "codemirror": "^6.0.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "cronstrue": "^3.32.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "@lucide/vue": "^1.59.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.1.10"
  }
}
